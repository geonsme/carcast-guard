<?xml version="1.0" encoding="utf-8"?>
<!-- 前景层：盾牌 + 对勾，沿用投屏宝的深炭黑底 + 绿→黄绿渐变描边（108dp 画布，安全区 66dp） -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:strokeWidth="5.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M54,26 L76,35 L76,57 L70,69 L61,77 L54,82 L47,77 L38,69 L32,57 L32,35 Z">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="32" android:startY="26"
                android:endX="76" android:endY="84"
                android:startColor="@color/guard_green_start"
                android:centerColor="@color/guard_green_mid"
                android:endColor="@color/guard_green_end" />
        </aapt:attr>
    </path>

    <path
        android:strokeWidth="6.4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M43,54 L51,63 L66,42">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="43" android:startY="63"
                android:endX="66" android:endY="42"
                android:startColor="@color/guard_green_mid"
                android:endColor="@color/guard_green_start" />
        </aapt:attr>
    </path>
</vector>
