<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_icon_tile">

            <ImageView
                android:id="@+id/targetIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:tint="@color/accent" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/targetName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/targetPkg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/rajdhani_medium"
                android:letterSpacing="0.05"
                android:textColor="@color/text_muted"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/targetPill"
            style="@style/Pill"
            android:background="@drawable/bg_pill_neutral" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:background="@color/stroke_soft" />

    <LinearLayout style="@style/TelemetryRow">

        <View
            android:id="@+id/row1Dot"
            style="@style/TelemetryDot" />

        <TextView
            android:id="@+id/row1Label"
            style="@style/TelemetryLabel"
            android:layout_marginStart="8dp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/row1Value"
            style="@style/TelemetryValue" />
    </LinearLayout>

    <LinearLayout style="@style/TelemetryRow">

        <View
            android:id="@+id/row2Dot"
            style="@style/TelemetryDot" />

        <TextView
            android:id="@+id/row2Label"
            style="@style/TelemetryLabel"
            android:layout_marginStart="8dp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/row2Value"
            style="@style/TelemetryValue" />
    </LinearLayout>

    <LinearLayout style="@style/TelemetryRow">

        <View
            android:id="@+id/row3Dot"
            style="@style/TelemetryDot" />

        <TextView
            android:id="@+id/row3Label"
            style="@style/TelemetryLabel"
            android:layout_marginStart="8dp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/row3Value"
            style="@style/TelemetryValue" />
    </LinearLayout>

    <TextView
        android:id="@+id/targetAction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="sans-serif-medium"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:text="@string/target_action_rebind"
        android:textColor="@color/accent"
        android:textSize="11sp"
        android:visibility="gone" />
</LinearLayout>
